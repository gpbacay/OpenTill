// Local SQLite file. Resolved relative to this schema file.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
  tenants      Tenant[]
}

model Session {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tenant {
  id           String    @id
  ownerId      String?
  name         String
  businessType String
  taxRate      Float
  currency     String
  createdAt    DateTime  @default(now())
  active       Boolean   @default(true)
  owner        User?     @relation(fields: [ownerId], references: [id])
  products     Product[]
  orders       Order[]
}

model Product {
  id          String   @id
  tenantId    String
  name        String
  category    String
  sku         String
  price       Float
  stock       Int
  description String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

model Order {
  id             String      @id
  tenantId       String
  status         String      // "COMPLETED" | "PENDING_SYNC" | "FAILED"
  subtotal       Float
  tax            Float
  total          Float
  paymentMethod  String      // "CASH" | "CARD" | "MOBILE_WALLET"
  isOffline      Boolean     @default(false)
  date           DateTime    @default(now())
  syncedAt       DateTime?
  cashierName    String?
  customerName   String?
  discountAmount Float?
  discountPercent Float?
  cashReceived   Float?
  changeDue      Float?
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  items          OrderItem[]
}

model OrderItem {
  id        String @id
  orderId   String
  productId String
  name      String
  price     Float
  quantity  Int
  order     Order  @relation(fields: [orderId], references: [id])
}
