// Local SQLite file. Resolved relative to this schema file.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"] // lets the Vercel API talk to Turso (hosted SQLite)
}

model User {
  id            String         @id
  name          String
  email         String         @unique
  passwordHash  String
  avatar        String         @default("") // small image data URL, "" for none
  role          String         @default("ADMIN") // "ADMIN" owns stores | "CASHIER" works the register of one store
  tenantId      String? // the store a CASHIER belongs to
  createdById   String? // the admin who created a CASHIER
  inviteHash    String?        @unique // sha256 of the cashier's sign-in link token
  inviteMaxUses Int            @default(1) // how many devices the link may sign in
  inviteDevices InviteDevice[]
  createdAt     DateTime       @default(now())
  sessions      Session[]
  tenants       Tenant[]       @relation("StoreOwner")
  store         Tenant?        @relation("StoreCashiers", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([createdById])
}

// A browser that signed in with a cashier's link. Only a hash of its device cookie is kept.
model InviteDevice {
  id         String   @id
  userId     String
  deviceHash String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
}

// Per store and topic, a counter that goes up with every change. Serverless hosting can't keep a live stream open,
// so browsers poll these counters (GET /api/changes) and re-fetch only what moved.
model Change {
  id       String @id // "<tenantId>:<topic>"
  tenantId String
  topic    String
  version  Int    @default(0)

  @@index([tenantId])
}

model Session {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tenant {
  id           String    @id
  ownerId      String?
  name         String
  businessType String
  taxRate      Float
  currency     String
  createdAt    DateTime  @default(now())
  active       Boolean   @default(true)
  owner        User?     @relation("StoreOwner", fields: [ownerId], references: [id])
  cashiers     User[]    @relation("StoreCashiers")
  products     Product[]
  orders       Order[]
}

model Product {
  id           String  @id
  tenantId     String
  name         String
  category     String
  sku          String
  price        Float
  stock        Int
  description  String
  costPrice    Float   @default(0)
  reorderLevel Int     @default(5)
  supplierId   String?
  custom       String  @default("{}") // JSON {customColumnId: value}
  image        String  @default("") // small image data URL, "" for none
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
}

model Order {
  id              String      @id
  tenantId        String
  status          String // "COMPLETED" | "PENDING_SYNC" | "FAILED"
  subtotal        Float
  tax             Float
  total           Float
  paymentMethod   String // "CASH" | "CARD" | "MOBILE_WALLET"
  isOffline       Boolean     @default(false)
  date            DateTime    @default(now())
  syncedAt        DateTime?
  cashierName     String?
  customerName    String?
  discountAmount  Float?
  discountPercent Float?
  cashReceived    Float?
  changeDue       Float?
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id        String @id
  orderId   String
  productId String
  name      String
  price     Float
  quantity  Int
  order     Order  @relation(fields: [orderId], references: [id])
}

model Supplier {
  id            String   @id
  tenantId      String
  name          String
  contactPerson String   @default("")
  phone         String   @default("")
  email         String   @default("")
  address       String   @default("")
  notes         String   @default("")
  active        Boolean  @default(true)
  custom        String   @default("{}")
  createdAt     DateTime @default(now())

  @@index([tenantId])
}

model Expense {
  id            String   @id
  tenantId      String
  date          DateTime
  category      String
  description   String
  amount        Float
  paymentMethod String   @default("CASH")
  supplierId    String?
  custom        String   @default("{}")
  createdAt     DateTime @default(now())

  @@index([tenantId, date])
}

// Append-only stock ledger. quantity is a signed delta: RESTOCK/OPENING add, SALE subtracts, ADJUSTMENT either.
model StockMovement {
  id          String   @id
  tenantId    String
  productId   String
  productName String
  type        String // "OPENING" | "RESTOCK" | "ADJUSTMENT" | "SALE"
  quantity    Int
  unitCost    Float?
  supplierId  String?
  note        String   @default("")
  date        DateTime @default(now())

  @@index([tenantId, date])
  @@index([productId])
}

// The product categories a store has set up. Products store the category's name, so renaming one renames it on its products.
model Category {
  id        String   @id
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// User-defined extra columns for the products / suppliers / expenses tables. Values live in each row's `custom` JSON.
model CustomColumn {
  id        String   @id
  tenantId  String
  tableName String // "products" | "suppliers" | "expenses"
  label     String
  type      String   @default("text") // "text" | "number" | "date"
  createdAt DateTime @default(now())

  @@index([tenantId])
}
