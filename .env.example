# Neon PostgreSQL connection string for Prisma
# Use role: neondb_owner (not authenticator)
# Connection pooling optional; TCP prisma db push may fail on some networks — use npm run db:push
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Nest API origin for Next.js rewrites (local default is http://localhost:3001)
# On Vercel, set this to your deployed Nest/API URL
# API_URL="https://your-api.example.com"
