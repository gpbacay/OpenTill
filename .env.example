# Local SQLite file (path is relative to prisma/schema.prisma)
DATABASE_URL="file:../data/opentill.db"

# Vercel only: hosted database (Turso). When set, it is used instead of DATABASE_URL.
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN=""

# Nest API origin for Next.js rewrites (local default is http://localhost:3001)
# API_URL="http://localhost:3001"
